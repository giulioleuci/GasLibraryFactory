{
  "name": "gaslibraryfactory-monorepo",
  "version": "3.0.0",
  "description": "Google Apps Script Library Factory - Monorepo with ES Modules and Webpack bundling",
  "type": "module",
  "main": "dist/Code.js",
  "scripts": {
    "build": "npm run build:tools && webpack --mode production",
    "build:readable": "npm run build:tools && webpack --mode production --env readable",
    "build:production": "npm run build:tools && node .cache/ts-tools/scripts/build-and-prepare.cjs --mode=production",
    "build:testing": "npm run build:tools && node .cache/ts-tools/scripts/build-and-prepare.cjs --mode=testing",
    "build:testoffline": "npm run build:tools && node .cache/ts-tools/scripts/build-and-prepare.cjs --mode=testoffline",
    "build:online": "npm run build:testing",
    "watch": "npm run build:tools && webpack --watch --mode production --env readable",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "push:production": "npm run build:production && clasp push",
    "push:testing": "npm run build:testing && clasp push",
    "push:online": "npm run build:online && clasp push",
    "docs": "npm run build:tools && node .cache/ts-tools/scripts/generate-docs.js",
    "docs:watch": "npm run build:tools && node .cache/ts-tools/scripts/generate-docs.js --watch",
    "test": "jest --reporters=summary --silent --no-stack-trace",
    "test:integration": "jest --config jest.integration.config.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck:online": "tsc -p tsconfig.online.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "build:types": "tsc -p tsconfig.declarations.json && mkdir -p .cache/types/types/vendor && cp types/vendor/jsep.d.cts .cache/types/types/vendor/jsep.d.cts",
    "pretest": "npm run build:tools && npm run build:types",
    "verify:typescript": "npm run typecheck && npm run typecheck:tools && npm run typecheck:online && npm run build:types && tsc -p tsconfig.consumer.json --noEmit && npm run lint && npm run build:testoffline -- --include-offline-tests=true && npm run build:testing && jest --config jest.offline.config.cjs --runInBand && npm run build:production && jest --config jest.offline.config.cjs --runInBand && npm run docs"
  },
  "keywords": [
    "google-apps-script",
    "gas",
    "library",
    "monorepo",
    "webpack",
    "es-modules",
    "resilience",
    "error-handling",
    "templating",
    "orm",
    "background-jobs"
  ],
  "author": "GasLibraryFactory",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.5.0",
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "2.0.13",
    "@types/he": "1.2.3",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "babel-jest": "^30.4.1",
    "babel-loader": "^9.1.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-prettier": "^5.5.6",
    "gas-webpack-plugin": "^2.3.0",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.2",
    "jsdoc-api": "^9.3.6",
    "prettier": "^3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giulioleuci/gaslibfactory.git"
  },
  "clasp": {
    "scriptId": "YOUR_SCRIPT_ID_HERE",
    "rootDir": "./dist"
  },
  "dependencies": {
    "es-toolkit": "1.43.0",
    "fuse.js": "^7.5.0",
    "he": "^1.2.0",
    "jsep": "^1.4.0",
    "zod": "^4.4.3"
  }
}
