{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["google-apps-script"],
    "baseUrl": ".",
    "paths": {
      "@ComposableContentLib": ["ComposableContentLib/index"],
      "@ComposableContentLib/*": ["ComposableContentLib/*"],
      "@ContextEngine": ["ContextEngine/index"],
      "@ContextEngine/*": ["ContextEngine/*"],
      "@CoreUtilsLib": ["CoreUtilsLib/index"],
      "@CoreUtilsLib/*": ["CoreUtilsLib/*"],
      "@DomainRepositoryLib": ["DomainRepositoryLib/index"],
      "@DomainRepositoryLib/*": ["DomainRepositoryLib/*"],
      "@GasDataImporter": ["GasDataImporter/index"],
      "@GasDataImporter/*": ["GasDataImporter/*"],
      "@GasExpressionEngineLib": ["GasExpressionEngineLib/index"],
      "@GasExpressionEngineLib/*": ["GasExpressionEngineLib/*"],
      "@GasOnlineTestFramework": ["GasOnlineTestFramework/index"],
      "@GasOnlineTestFramework/*": ["GasOnlineTestFramework/*"],
      "@GasResilienceLib": ["GasResilienceLib/index"],
      "@GasResilienceLib/*": ["GasResilienceLib/*"],
      "@GasSchemaValidatorLib": ["GasSchemaValidatorLib/index"],
      "@GasSchemaValidatorLib/*": ["GasSchemaValidatorLib/*"],
      "@GoogleApiWrapper": ["GoogleApiWrapper/index"],
      "@GoogleApiWrapper/*": ["GoogleApiWrapper/*"],
      "@JobRunnerLib": ["JobRunnerLib/index"],
      "@JobRunnerLib/*": ["JobRunnerLib/*"],
      "@PipelineFramework": ["PipelineFramework/index"],
      "@PipelineFramework/*": ["PipelineFramework/*"],
      "@RoleResolutionLib": ["RoleResolutionLib/index"],
      "@RoleResolutionLib/*": ["RoleResolutionLib/*"],
      "@SheetDBLib": ["SheetDBLib/index"],
      "@SheetDBLib/*": ["SheetDBLib/*"],
      "@WorkspaceTemplateEngine": ["WorkspaceTemplateEngine/index"],
      "@WorkspaceTemplateEngine/*": ["WorkspaceTemplateEngine/*"],
      "jsep": ["types/vendor/jsep.d.cts"],
      "@GasProcessMonitorLib": ["GasProcessMonitorLib/index"],
      "@GasProcessMonitorLib/*": ["GasProcessMonitorLib/*"]
    }
  }
}
