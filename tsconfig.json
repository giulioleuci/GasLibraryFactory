{
  "extends": "./tsconfig.base.json",
  "include": [
    "ComposableContentLib/**/*",
    "ContextEngine/**/*",
    "CoreUtilsLib/**/*",
    "DomainRepositoryLib/**/*",
    "GasDataImporter/**/*",
    "GasExpressionEngineLib/**/*",
    "GasOnlineTestFramework/**/*",
    "GasResilienceLib/**/*",
    "GasSchemaValidatorLib/**/*",
    "GoogleApiWrapper/**/*",
    "JobRunnerLib/**/*",
    "PipelineFramework/**/*",
    "RoleResolutionLib/**/*",
    "SheetDBLib/**/*",
    "WorkspaceTemplateEngine/**/*",
    "src/**/*",
    "types/**/*.d.ts",
    "test/types/**/*.ts"
